# AssemblyAI Voice Agent API Configuration
# Get your API key from: https://www.assemblyai.com/dashboard/api-keys
# Used by the Vite dev server; do not prefix this with VITE_ or it will be exposed to the browser.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Agent ID from publishing your agent with voice-agent-starter-js
# Run: cd voice-agent-starter-js && AGENT=minimal npm run publish
# Then copy the AGENT_ID_MINIMAL value from .env
VITE_ASSEMBLYAI_AGENT_ID=your_agent_id_here

# Token endpoint configuration. The Vite dev server provides /token locally.
VITE_TOKEN_ENDPOINT=/token

# Set to "true" to force mock mode for development/testing
# VITE_USE_MOCK_VOICE=true
